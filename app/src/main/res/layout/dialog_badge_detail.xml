<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_detail_badge_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌿"
        android:textSize="64sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_detail_badge_tier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="STARTER"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#757575"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tv_detail_badge_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Badge Name"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_detail_badge_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Description"
        android:textSize="14sp"
        android:textColor="#424242"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/tv_detail_badge_criteria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Criteria: —"
        android:textSize="13sp"
        android:textColor="#009688"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_detail_badge_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Not yet earned"
        android:textSize="12sp"
        android:textColor="#9E9E9E"
        android:gravity="center" />

</LinearLayout>
