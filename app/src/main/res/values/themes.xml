<resources>
    <!-- Main application theme — no action bar (we use custom toolbars) -->
    <style name="Theme.EcoLums" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/teal_primary</item>
        <item name="colorPrimaryDark">@color/teal_dark</item>
        <item name="colorAccent">@color/green_accent</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/teal_primary</item>
    </style>

    <!-- Teal toolbar style used in most activities -->
    <style name="TealToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/teal_primary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Card style for dark score cards (Home screen) -->
    <style name="DarkScoreCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_black</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- Admin badge chip style -->
    <style name="AdminChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/admin_badge</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Semester filter tab (RadioButton styled as pill toggle) -->
    <style name="SemesterTab" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:button">@null</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:background">@drawable/bg_tab_unselected</item>
    </style>
</resources>
