rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // -----------------------------------------------------------------------
    // users/{userId}
    // -----------------------------------------------------------------------
    match /users/{userId} {
      // Any signed-in user can read profile fields (needed for leaderboard name lookups)
      allow read: if isAuthenticated();
      // Only the account owner or an admin may write the user document
      allow write: if isOwner(userId) || isAdmin();

      match /activityLogs/{logId} {
        allow read, write: if isOwner(userId);
      }

      match /badges/{badgeId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) || isAdmin();
      }

      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        // Notifications written by the app on behalf of the owner, or by admin
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // -----------------------------------------------------------------------
    // clubs/{clubId}
    // -----------------------------------------------------------------------
    match /clubs/{clubId} {
      allow read: if isAuthenticated();
      // Admins or the club's own leader may update club data
      allow update: if isAuthenticated() &&
        (isAdmin() ||
         resource.data.leaderId == request.auth.uid);
      // Only admins can create or delete clubs
      allow create, delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // challenges/{challengeId}
    // -----------------------------------------------------------------------
    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      // Participants may update only their own score and the participantIds list
      allow update: if isAuthenticated() &&
        (isAdmin() ||
         (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participantScores', 'participantIds'])));
    }

    // -----------------------------------------------------------------------
    // campusGoals/{goalId}
    // -----------------------------------------------------------------------
    match /campusGoals/{goalId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      // Progress increments are written by any logged-in user after logging an activity
      allow update: if isAuthenticated();
    }

    // -----------------------------------------------------------------------
    // badges/{badgeId}  (global definitions, written by admin/seeder)
    // -----------------------------------------------------------------------
    match /badges/{badgeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // calculationMetrics/{metricId}
    // -----------------------------------------------------------------------
    match /calculationMetrics/{metricId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // sustainabilityTips/{tipId}
    // -----------------------------------------------------------------------
    match /sustainabilityTips/{tipId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // broadcastNotifications/{notifId}
    // -----------------------------------------------------------------------
    match /broadcastNotifications/{notifId} {
      allow read: if isAuthenticated();
      // Written by the app when a campus goal or challenge milestone is crossed
      allow write: if isAuthenticated();
    }

    // -----------------------------------------------------------------------
    // platformConfig/{docId}
    // -----------------------------------------------------------------------
    match /platformConfig/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // seeded/{docId}  (seeder sentinel — prevents re-seeding)
    // -----------------------------------------------------------------------
    match /seeded/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // -----------------------------------------------------------------------
    // adminAudit/{docId}
    // -----------------------------------------------------------------------
    match /adminAudit/{docId} {
      allow read, write: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // federated/{userId}  — per-user FL correction uploads
    // Each user may only write their own document; admins can read all.
    // -----------------------------------------------------------------------
    match /federated/{userId} {
      allow read:  if isAdmin();
      allow write: if isOwner(userId);
    }

    // -----------------------------------------------------------------------
    // federatedGlobal/{docId}  — aggregated FedAvg correction (read by all)
    // Written only by the aggregation script using the Admin SDK (bypasses rules).
    // -----------------------------------------------------------------------
    match /federatedGlobal/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
