<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top row: category badge + display name + info button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_metric_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transport"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@color/teal_primary"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <TextView
                android:id="@+id/tv_metric_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Bike (CO₂ saved/km)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tv_metric_info"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="ℹ"
                android:textSize="18sp"
                android:textColor="@color/teal_primary"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Value row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tv_metric_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0.21 kg CO₂/km"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/teal_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_metric"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Edit"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:backgroundTint="@color/teal_primary"
                app:cornerRadius="8dp" />

        </LinearLayout>

        <!-- Reference standard -->
        <TextView
            android:id="@+id/tv_metric_reference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="EPA 2024"
            android:textSize="11sp"
            android:textColor="@color/text_hint" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
